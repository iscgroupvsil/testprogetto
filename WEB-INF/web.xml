<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>Notifiche Minute PWA</display-name>

  <!-- Serve index.html quando si richiede la root del context path -->
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

  <!--
    Tomcat non ha di default un mime-type per .webmanifest: senza questa
    mappatura il manifest verrebbe servito come application/octet-stream e
    alcuni browser rifiuterebbero l'installazione della PWA.
  -->
  <mime-mapping>
    <extension>webmanifest</extension>
    <mime-type>application/manifest+json</mime-type>
  </mime-mapping>

  <mime-mapping>
    <extension>json</extension>
    <mime-type>application/json</mime-type>
  </mime-mapping>

</web-app>
